{
    "$schema": "vendor-bin/infection/vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "testFramework": "testo",
    // The acceptance suite runs the application in a separate process, out of reach of mutants and coverage.
    "testFrameworkOptions": "--suite=Functional",
    "tmpDir": "runtime",
    "timeout": 10,
    "logs": {
        "text": "runtime/infection.log",
        "github": true,
        "stryker": {
            "report": "master"
        }
    }
}
