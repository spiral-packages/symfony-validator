{
    "name": "spiral-packages/symfony-validator",
    "description": "Symfony validator bridge for Spiral Framework",
    "keywords": [
        "spiral",
        "spiral-framework",
        "symfony",
        "validator",
        "validation",
        "filters",
        "attributes"
    ],
    "homepage": "https://spiral.dev/docs/validation-symfony",
    "license": "MIT",
    "authors": [
        {
            "name": "butschster",
            "email": "butschster@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Aleksei Gagarin (roxblnfk)",
            "email": "alexey.gagarin@spiralscout.com"
        }
    ],
    "support": {
        "docs": "https://spiral.dev/docs/validation-symfony",
        "issues": "https://github.com/spiral-packages/symfony-validator/issues",
        "source": "https://github.com/spiral-packages/symfony-validator"
    },
    "require": {
        "php": "^8.2",
        "spiral/attributes": "^2.8 || ^3.0",
        "spiral/filters": "^3.1",
        "spiral/http": "^3.1",
        "spiral/validation": "^3.1",
        "symfony/cache": "^6.4 || ^7.0 || ^8.0",
        "symfony/psr-http-message-bridge": "^2 || ^6.4 || ^7.0 || ^8.0",
        "symfony/validator": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "buggregator/trap": "^1.13",
        "llm/skills": "^1.23",
        "roxblnfk/unpoly": "^1.8",
        "spiral/framework": "^3.15",
        "spiral/nyholm-bridge": "^1.2",
        "testo/bridge-infection": "^0.1.9",
        "testo/testo": "^0.10.55",
        "vimeo/psalm": "^6 || ^7"
    },
    "autoload": {
        "psr-4": {
            "Spiral\\Validation\\Symfony\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spiral\\Validation\\Symfony\\Tests\\App\\": "tests/app",
            "Spiral\\Validation\\Symfony\\Tests\\": "tests/src"
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix -v --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "infect": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --threads=max --min-msi=100 --min-covered-msi=100"
        ],
        "infect:ci": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --ansi --threads=max --logger-github --show-mutations=0 --min-msi=100 --min-covered-msi=100"
        ],
        "test": "vendor/bin/testo",
        "psalm": "vendor/bin/psalm --config=psalm.xml ./src"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "spiral/composer-publish-plugin": true,
            "llm/skills": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false,
            "target-directory": "vendor-bin"
        },
        "spiral": {
            "bootloaders": [
                "Spiral\\Validation\\Symfony\\Bootloader\\ValidatorBootloader"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
